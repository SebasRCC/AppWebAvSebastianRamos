<?xml version="1.0" encoding="UTF-8"?>
<!--
  PoliMusic · Configuracion IIS / IIS Express
  Documento por defecto: login.asp
  Nota: no se define la seccion <asp> porque IIS Express falla al
  inicializar Classic ASP cuando se sobreescribe a nivel de sitio.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="login.asp" />
        <add value="default.asp" />
        <add value="index.asp" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>
